# PostgreSQL 数据库配置（与 ShardingSphere 配置中的密码一致）
POSTGRES_PASSWORD=YourStrongPassword

# Redis 配置  
REDIS_PASSWORD=YourStrongPassword

# JVM 内存配置（可选，根据服务器配置调整）
JAVA_OPTS=-Xmx2048m -Xms1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# 应用域名
SHORTLINK_DOMAIN=localhost:8068

# Spring Boot 虚拟线程（可选）
SPRING_THREADS_VIRTUAL_ENABLED=false
